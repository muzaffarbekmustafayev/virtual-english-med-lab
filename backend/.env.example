# ==========================================
# Virtual Patient English - Production Backend .env
# ==========================================

# Port (Host / Cloud port, e.g. 5000)
PORT=5000
NODE_ENV=production

# Database (MySQL / MariaDB on your host/server)
DB_HOST=localhost
DB_PORT=3306
DB_USER=vpe_user
DB_PASS=YourStrongDbPassword123!
DB_NAME=virtual_patient_db

# Security & Authentication
# Generate a strong 64+ char random string for JWT_SECRET
JWT_SECRET=vpe_prod_jwt_super_secure_secret_key_change_me_938472918472

# Google Gemini AI API Key (Get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=YourGeminiApiKeyHere

# CORS / Allowed Frontend URLs (comma-separated for multiple domains or IPs)
# Example: https://yourdomain.com,https://api.yourdomain.com,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://yourdomain.uz

# Optional: Frontend URL
FRONTEND_URL=https://yourdomain.uz
