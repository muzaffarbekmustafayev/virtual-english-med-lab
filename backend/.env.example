# Environment Variables - Virtual Patient English Backend
# Copy this file to .env and fill in your values

# ================================
# DATABASE (MySQL)
# ================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=virtual_patient_db

# ================================
# JWT Authentication
# ================================
JWT_SECRET=virtual_patient_super_secret_key_change_this_2024

# ================================
# Google Gemini AI
# ================================
GEMINI_API_KEY=your_gemini_api_key_here

# ================================
# Server
# ================================
PORT=5000
NODE_ENV=development
